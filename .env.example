# Optional environment overrides for SelfHealingSelenium.
# Copy to .env (or set as real environment variables) and fill in values.
# The app reads standard configuration keys; nothing here is required.

# Override the target page URL
TargetUrl=https://app.cloudqa.io/home/AutomationPracticeForm

# Browser to launch: Chrome or Edge
Browser=Chrome

# Run the browser headless: true or false
Headless=true
